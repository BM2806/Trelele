# Disabled by default; this file contains no working credentials.
AUTH_ENABLED=false
PORT=8080
BETTER_AUTH_URL=https://YOUR-STABLE-APP-DOMAIN
BETTER_AUTH_SECRET=
DATABASE_URL=

# Configure each selected provider completely; leave all fields empty otherwise.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# SMTP 465 (implicit TLS) or 587 (required STARTTLS). No insecure SMTP fallback.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
AUTH_EMAIL_FROM=
